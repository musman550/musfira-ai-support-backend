# Copy this file to ".env" and fill in values ONLY for a real deployment.
# .env is for a persistent server (local always-on machine, or Vercel env
# vars) — NOT for everyday local testing. For everyday testing, paste a key
# into the Settings tab in the browser instead; it is never saved to disk
# and is forgotten the moment you refresh the page, on purpose.
#
# Leave everything below blank for normal local testing via run_dashboard.bat.

# FREE — get this at https://console.groq.com
# Only set this for a real always-on deployment (e.g. Vercel env vars).
GROQ_API_KEY=

# FREE — get this at https://aistudio.google.com/apikey
# Alternative to GROQ_API_KEY — only one of the two is needed, matching
# whichever PROVIDER is selected in Settings.
GEMINI_API_KEY=

# Only relevant for a real deployment too — the Dashboard password can
# also just be set from the Settings tab in the browser (saved to
# config.json there, which is fine since it's not a third-party credential).
ADMIN_KEY=

# The domain your chat widget will be copied into, e.g. https://musfiraai.com
# Use * while testing locally.
ALLOWED_ORIGIN=*
